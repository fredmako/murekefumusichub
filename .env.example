# Frontend environment variables
# Copy this file to .env.local before building/running the frontend.

# Required
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API base URL
# Use /api when frontend and backend are served from the same domain.
# Use full URL if backend is on another domain/subdomain.
VITE_API_BASE_URL=/api

# Optional
VITE_GOOGLE_CLIENT_ID=
VITE_ADMIN_IDENTIFIERS=admin@example.com,owner@example.com
# Force auth redirects to a specific frontend base URL (recommended for production)
# Example: https://murekefumusichub.vercel.app
VITE_AUTH_REDIRECT_BASE_URL=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://choral-server-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/callback/",
      "destination": "/auth/callback"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}

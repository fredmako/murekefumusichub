{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murekefumusichub",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "type": "module",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}

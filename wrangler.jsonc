{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murekefumusichub",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "murekefu-db",
      "database_id": "117b6082-cd56-40d8-8f77-85b8d4e8f19e"
    }
  ],

  // R2 object storage — ACTIVE as of 2026-09-28.
  //
  // R2 had to be enabled once from the Cloudflare Dashboard (the API returns
  // code 10042, "Please enable R2 through the Cloudflare Dashboard", and offers
  // no programmatic bypass), then the bucket was created via the API:
  //   PUT /accounts/{id}/r2/buckets/murekefu-storage
  //
  // `storeUpload()` in worker.js writes here when `c.env.STORAGE` is bound and
  // falls back to an inline data URL only if a put fails, so uploads never break
  // on a storage error. `/api/media/thumbnail/*` serves objects back out of this
  // same bucket, and the URL it mints is what gets stored in
  // compositions.pdf_r2_key / thumbnail_r2_key.
  //
  // Existing rows written while this was inactive still hold inline data URLs.
  // They keep working; a backfill can rewrite them to object keys later.
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "murekefu-storage"
    }
  ]
}

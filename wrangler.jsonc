{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murekefumusichub",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "murekefu-db",
      "database_id": "117b6082-cd56-40d8-8f77-85b8d4e8f19e"
    }
  ]
}
